---
import Logo from './Logo.astro';
---
<div class="relative mx-auto aspect-[3/4] w-full max-w-[17rem] bg-navy p-7 text-paper shadow-[0_30px_60px_-20px_rgba(13,33,56,0.55)]" role="img" aria-label="Cover of the free guide: The Great Thing About Hard Conversations">
  <div class="absolute inset-x-7 top-7"><Logo uid="gc" on="dark" mode="mono" class="h-6 w-auto" /></div>
  <div class="absolute inset-x-7 bottom-8">
    <span class="block h-0.5 w-10 bg-gold"></span>
    <p class="mt-5 text-[1.65rem] font-light leading-[1.1] tracking-tight">The Great Thing About Hard Conversations</p>
    <p class="mt-4 text-[0.7rem] leading-snug text-fog">How the conversations we avoid can become the conversations that move us forward.</p>
    <p class="mt-5 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-gold">Vincent Azé</p>
  </div>
</div>
