---
interface Props { title: string; updated: string }
const { title, updated } = Astro.props;
---
<div class="container-x py-12 lg:py-20">
  <p class="label text-teal-deep">Legal</p>
  <h1 class="mt-3 font-serif text-4xl md:text-5xl text-ink">{title}</h1>
  <p class="mt-3 text-sm text-steel">Last updated {updated}</p>
  <div class="prose prose-neutral mt-10 max-w-3xl prose-headings:font-serif prose-headings:font-normal prose-a:text-ink">
    <slot />
  </div>
</div>
