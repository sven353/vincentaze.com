---
import type { Faq } from '../data/faq';
interface Props { items: Faq[] }
const { items } = Astro.props;
// Render [text](url) as external links, everything else as escaped text.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const html = (md: string) =>
  esc(md).replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="border-b border-ink hover:border-teal-deep hover:text-teal-deep">$1<span class="sr-only"> (opens in a new tab)</span></a>');
---
<div class="divide-y divide-line-strong/70 border-y border-line-strong/70">
  {items.map((f) => (
    <div class="py-6 lg:py-7">
      <h3 class="font-serif text-xl md:text-2xl text-ink leading-snug">{f.q}</h3>
      <p class="mt-2 max-w-[62ch] text-[15px] sm:text-base leading-[1.7] text-ink">{f.verdict}</p>
      <details class="group mt-3">
        <summary class="inline-flex cursor-pointer list-none items-center gap-2 text-sm text-teal-deep hover:text-ink [&::-webkit-details-marker]:hidden">
          <span class="group-open:hidden">Read context</span><span class="hidden group-open:inline">Hide context</span>
          <span aria-hidden="true" class="transition-transform group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 max-w-[62ch] text-[15px] sm:text-base leading-[1.7] text-steel" set:html={html(f.body)} />
      </details>
    </div>
  ))}
</div>
