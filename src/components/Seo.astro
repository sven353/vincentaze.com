---
import { site } from '../data/site';
import type { Faq } from '../data/faq';

interface ArticleMeta { headline: string; datePublished: string; dateModified: string }
interface Props {
  title: string;
  description: string;
  path: string;
  type?: 'WebPage' | 'ProfilePage' | 'ContactPage' | 'CollectionPage';
  faq?: Faq[];
  article?: ArticleMeta;
  noindex?: boolean;
}
const { title, description, path, type = 'WebPage', faq, article, noindex = false } = Astro.props;

const base = site.url;
const url = base + (path === '/' ? '' : path);
const ogImage = `${base}/og.png`;
const strip = (md: string) => md.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');

const ids = {
  vincent: `${base}/#vincent-aze`,
  kuma: 'https://www.kuma.partners/#organization',
  sven: 'https://mulfinger.com/#sven-mulfinger',
  site: `${base}/#website`,
};

const vincent = {
  '@type': 'Person',
  '@id': ids.vincent,
  name: site.name,
  givenName: 'Vincent',
  familyName: 'Azé',
  alternateName: 'Vincent Aze',
  jobTitle: site.profession,
  description:
    'Executive coach and founding partner of Kuma Partners, focused on leadership friction, founder alignment and the human side of AI.',
  url: base,
  image: `${base}/vincent-aze.jpg`,
  homeLocation: { '@type': 'Place', name: site.place },
  knowsLanguage: ['en', 'fr'],
  worksFor: { '@id': ids.kuma },
  colleague: { '@id': ids.sven },
  sameAs: [site.linkedin],
  knowsAbout: [
    'Executive coaching',
    'Leadership friction',
    'Founder and co-founder alignment',
    'Emotional intelligence',
    'The future of work',
    'AI and leadership',
    'Leadership team alignment',
  ],
};

const kuma = {
  '@type': ['Organization', 'ProfessionalService'],
  '@id': ids.kuma,
  name: site.org,
  url: site.links.kuma,
  description:
    'Kuma Partners is a leadership advisory firm working with founders and executive teams through strategic inflection points.',
  founder: [{ '@id': ids.vincent }, { '@id': ids.sven }],
  knowsAbout: ['Leadership friction', 'Leadership team alignment', 'Strategic offsites', 'Executive peer advisory'],
  sameAs: [site.links.offsite, site.links.round],
};

const sven = {
  '@type': 'Person',
  '@id': ids.sven,
  name: 'Dr. Sven Mulfinger',
  url: site.links.sven,
  sameAs: [site.links.svenLinkedin],
  worksFor: { '@id': ids.kuma },
};

const services = [
  {
    '@type': 'Service',
    '@id': `${base}/advisory#coaching`,
    name: '1:1 Executive Coaching and Advisory',
    serviceType: 'Executive coaching',
    description:
      'Confidential conversations for founders and senior executives navigating growth, change, conflict or important decisions.',
    provider: { '@id': ids.vincent },
    url: `${base}/advisory`,
  },
  {
    '@type': 'Service',
    '@id': `${base}/advisory#scan`,
    name: '14-Day Leadership Friction Scan',
    serviceType: 'Leadership team diagnostic',
    description: 'The entry offer from Kuma Partners for leadership teams whose friction is systemic rather than individual.',
    provider: { '@id': ids.kuma },
    url: site.links.scan,
  },
  {
    '@type': 'Service',
    '@id': `${base}/advisory#offsites`,
    name: 'Leadership team offsites',
    serviceType: 'Executive offsite design and facilitation',
    provider: { '@id': ids.kuma },
    url: site.links.offsite,
  },
];

const webSite = { '@type': 'WebSite', '@id': ids.site, url: base, name: site.name, inLanguage: 'en', publisher: { '@id': ids.vincent } };
const webPage: Record<string, unknown> = {
  '@type': type,
  '@id': `${url}#webpage`,
  url,
  name: title,
  description,
  inLanguage: 'en',
  isPartOf: { '@id': ids.site },
  about: { '@id': ids.vincent },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
};
if (type === 'ProfilePage') webPage.mainEntity = { '@id': ids.vincent };

const graph: unknown[] = [vincent, kuma, sven, ...services, webSite, webPage];

// Dated event on the home page. Remove or update after the event has taken place.
if (path === '/') {
  graph.push({
    '@type': 'Event',
    '@id': `${base}/#portugal-tech-week-talk`,
    name: 'The Human Side of AI: Emotional Intelligence and the Future of Work',
    description: 'A talk by Vincent Azé at Portugal Tech Week on emotional intelligence, human judgement and the future of work.',
    startDate: '2026-11-11',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    location: { '@type': 'Place', name: 'Portugal Tech Week', address: { '@type': 'PostalAddress', addressLocality: 'Lisbon', addressCountry: 'PT' } },
    performer: { '@id': ids.vincent },
    image: ogImage,
  });
}

if (article) {
  graph.push({
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: article.headline,
    description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: 'en',
    author: { '@id': ids.vincent },
    publisher: { '@id': ids.vincent },
    mainEntityOfPage: { '@id': `${url}#webpage` },
    image: ogImage,
    isPartOf: { '@id': ids.site },
  });
}

if (faq?.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: `${f.verdict} ${strip(f.body)}` },
    })),
  });
}
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
<meta property="og:type" content={article ? 'article' : type === 'ProfilePage' ? 'profile' : 'website'} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Vincent Azé, executive coach and founding partner of Kuma Partners" />
{article && <meta property="article:published_time" content={article.datePublished} />}
{article && <meta property="article:modified_time" content={article.dateModified} />}
{article && <meta property="article:author" content={site.name} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
<link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM full profile" />
<script type="application/ld+json" set:html={jsonld} />
