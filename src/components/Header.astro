---
import { site } from '../data/site';
import Logo from './Logo.astro';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const active = (href: string) => !href.includes('#') && (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="sticky top-0 z-40 border-b border-charcoal-line bg-charcoal/95 text-bone backdrop-blur">
  <div class="container-x flex h-[4.25rem] items-center justify-between gap-4">
    <a href="/" class="flex min-h-11 items-center" aria-label="Vincent Azé, home">
      <Logo uid="hd" on="dark" class="hidden h-10 w-auto sm:block" />
      <Logo uid="hm" on="dark" mode="mono" class="h-8 w-auto sm:hidden" />
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-9 text-[0.95rem] md:flex">
      {site.nav.map((n) => (
        <a href={n.href} aria-current={active(n.href) ? 'page' : undefined} class:list={['inline-flex min-h-11 items-center border-b-2 transition-colors hover:text-amber', active(n.href) ? 'border-amber text-bone' : 'border-transparent text-fog']}>{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href={site.cta.href} class="btn-primary !min-h-11 !px-4 !py-2 !text-[0.9rem] max-[374px]:hidden md:!px-5">{site.cta.label}</a>
      <button id="menu-open" type="button" class="group -mr-2 inline-flex size-11 items-center justify-center md:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h18M3 16h18" /></svg>
      </button>
    </div>
  </div>
</header>
<!-- Dropdown panel sits outside the header element so backdrop-filter cannot trap its fixed positioning. -->
<div id="drawer" class="fixed inset-x-0 top-[4.25rem] z-30 hidden border-b border-charcoal-line bg-charcoal text-bone shadow-2xl md:hidden">
  <nav aria-label="Mobile" class="container-x flex flex-col pb-4 pt-1">
    {[...site.nav, { href: '/#guide', label: 'Free guide' }, { href: '/ideas', label: 'Ideas' }, { href: '/contact', label: 'Contact' }].map((n) => (
      <a href={n.href} class="flex min-h-14 items-center border-b border-charcoal-line text-xl font-light">{n.label}</a>
    ))}
    <a href={site.cta.href} class="btn-primary mt-5">{site.cta.label} <span aria-hidden="true">→</span></a>
  </nav>
</div>
