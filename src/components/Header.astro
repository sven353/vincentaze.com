---
import { site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between">
    <a href="/" class="font-serif text-xl text-ink tracking-tight">Vincent Azé</a>
    <nav aria-label="Primary" class="hidden md:flex items-center gap-8 text-sm">
      {site.nav.filter((n) => n.href !== '/').map((n) => (
        <a href={n.href} aria-current={path === n.href ? 'page' : undefined} class:list={['border-b pb-0.5 transition-colors', path === n.href ? 'border-navy text-ink' : 'border-transparent text-steel hover:text-ink']}>{n.label}</a>
      ))}
      <a href="/contact" class="rounded-sm bg-navy px-4 py-2 text-paper hover:bg-navy-hover transition-colors">Discuss a challenge</a>
    </nav>
    <button id="menu-open" type="button" class="md:hidden -mr-2 p-2" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h16M3 15h16" /></svg>
    </button>
  </div>
</header>
<!-- The drawer sits outside <header> on purpose: backdrop-filter would otherwise trap its fixed positioning. -->
<div id="drawer" class="fixed inset-0 z-50 hidden bg-paper" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="container-x flex h-16 items-center justify-between">
    <a href="/" class="font-serif text-xl text-ink tracking-tight">Vincent Azé</a>
    <button id="menu-close" type="button" class="-mr-2 p-2" aria-label="Close menu">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 4l14 14M18 4L4 18" /></svg>
    </button>
  </div>
  <nav aria-label="Mobile" class="container-x mt-8 flex flex-col">
    {site.nav.map((n) => (
      <a href={n.href} class="border-b border-line py-5 font-serif text-3xl text-ink">{n.label}</a>
    ))}
  </nav>
</div>
