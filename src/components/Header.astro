---
import { site } from '../data/site';
import Logo from './Logo.astro';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const active = (href: string) => !href.includes('#') && (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="sticky top-0 z-40 border-b border-navy-line bg-navy/95 text-paper backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between">
    <a href="/" class="flex items-center" aria-label="Vincent Azé, home">
      <Logo uid="hd" on="dark" class="hidden h-10 w-auto sm:block" />
      <Logo uid="hm" on="dark" mode="mono" class="h-7 w-auto sm:hidden" />
    </a>
    <nav aria-label="Primary" class="hidden md:flex items-center gap-8 text-sm">
      {site.nav.filter((n) => n.href !== '/').map((n) => (
        <a href={n.href} aria-current={active(n.href) ? 'page' : undefined} class:list={['border-b-2 pb-0.5 transition-colors hover:text-gold', active(n.href) ? 'border-gold text-paper' : 'border-transparent text-fog']}>{n.label}</a>
      ))}
    </nav>
    <button id="menu-open" type="button" class="md:hidden -mr-2 p-2" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h16M3 15h16" /></svg>
    </button>
  </div>
</header>
<!-- The drawer sits outside <header> on purpose: backdrop-filter would otherwise trap its fixed positioning. -->
<div id="drawer" class="fixed inset-0 z-50 hidden bg-navy text-paper" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="container-x flex h-16 items-center justify-between">
    <Logo uid="hdr" on="dark" class="h-8 w-auto" />
    <button id="menu-close" type="button" class="-mr-2 p-2" aria-label="Close menu">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 4l14 14M18 4L4 18" /></svg>
    </button>
  </div>
  <nav aria-label="Mobile" class="container-x mt-8 flex flex-col">
    {site.nav.map((n) => (
      <a href={n.href} class="border-b border-navy-line py-4 text-3xl font-light tracking-tight">{n.label}</a>
    ))}
  </nav>
</div>
