---
import { legal } from '../data/legal';
---
<div>
<form name="contact" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="bot-field" class="js-form space-y-6" novalidate>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden"><label>Leave this empty <input name="bot-field" /></label></p>
  <div>
    <label for="c-name" class="block text-base font-bold text-ink">Name</label>
    <input id="c-name" name="name" type="text" required autocomplete="name" class="field mt-2" />
  </div>
  <div>
    <label for="c-email" class="block text-base font-bold text-ink">Email</label>
    <input id="c-email" name="email" type="email" required autocomplete="email" class="field mt-2" />
  </div>
  <div>
    <label for="c-msg" class="block text-base font-bold text-ink">What would you like to discuss?</label>
    <textarea id="c-msg" name="message" rows="5" required class="field mt-2 min-h-40"></textarea>
  </div>
  <div class="flex items-start gap-3">
    <input id="c-consent" name="privacy_consent" type="checkbox" value="accepted" required class="mt-0.5 size-6 shrink-0 accent-charcoal" />
    <label for="c-consent" class="text-[0.95rem] leading-relaxed text-steel">I have read the <a class="border-b border-ink text-ink" href="/privacy">privacy policy</a> and agree that Vincent Azé uses my details to reply to this message.</label>
  </div>
  <p data-error class="hidden rounded-sm border border-error bg-white p-3 text-[0.95rem] text-error" role="alert"></p>
  <button type="submit" class="btn-primary w-full sm:w-auto">Start a conversation <span aria-hidden="true">→</span></button>
  <p class="text-xs leading-relaxed text-steel">Controller: {legal.owner}. Purpose: replying to your message. Basis: your consent. Stored in Netlify Forms and kept only as long as needed to handle your message.</p>
</form>
<div data-success class="hidden rounded-md border border-line bg-white p-8" role="status" tabindex="-1">
  <h2 class="text-2xl font-light text-ink">Thank you.</h2>
  <p class="mt-3 text-steel">I have received your message and will reply personally.</p>
</div>
</div>
