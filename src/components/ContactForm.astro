---
import { legal } from '../data/legal';
---
<div>
<form name="contact" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="bot-field" class="js-form space-y-5" novalidate>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden"><label>Leave this empty <input name="bot-field" /></label></p>
  <div>
    <label for="c-name" class="block text-sm font-bold text-ink">Name</label>
    <input id="c-name" name="name" type="text" required autocomplete="name" class="mt-2 w-full rounded-sm border border-line-strong bg-white px-4 py-3 text-base" />
  </div>
  <div>
    <label for="c-email" class="block text-sm font-bold text-ink">Email</label>
    <input id="c-email" name="email" type="email" required autocomplete="email" class="mt-2 w-full rounded-sm border border-line-strong bg-white px-4 py-3 text-base" />
  </div>
  <div>
    <label for="c-msg" class="block text-sm font-bold text-ink">What would you like to discuss?</label>
    <textarea id="c-msg" name="message" rows="5" required class="mt-2 w-full rounded-sm border border-line-strong bg-white px-4 py-3 text-base"></textarea>
  </div>
  <div class="flex items-start gap-3">
    <input id="c-consent" name="privacy_consent" type="checkbox" value="accepted" required class="mt-1 size-4 accent-navy" />
    <label for="c-consent" class="text-sm leading-relaxed text-steel">I have read the <a class="border-b border-ink" href="/privacy">privacy policy</a> and agree that Vincent Azé uses my details to reply to this message.</label>
  </div>
  <p class="text-xs leading-relaxed text-steel">Controller: {legal.owner}. Purpose: replying to your message. Basis: your consent. Stored in Netlify Forms and kept only as long as needed to handle your message.</p>
  <p data-error class="hidden text-sm text-red-700" role="alert"></p>
  <button type="submit" class="inline-flex items-center gap-2 rounded-sm bg-navy px-6 py-3.5 text-sm font-bold text-paper hover:bg-navy-hover transition-colors">Send message <span aria-hidden="true">→</span></button>
</form>
<div data-success class="hidden rounded-sm border border-line bg-white p-8" role="status" tabindex="-1">
  <h2 class="text-2xl font-light text-ink">Thank you.</h2>
  <p class="mt-3 text-steel">I have received your message and will reply personally.</p>
</div>
</div>
