---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
---
<Layout
  path="/contact"
  type="ContactPage"
  title="Discuss a leadership challenge"
  description="Contact Vincent Azé, Managing Partner at Kuma Partners, about executive friction or decision latency in your leadership team. Confidential, with a reply within 24 to 48 hours."
>
  <section class="container-x py-12 lg:py-24 lg:grid lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <p class="label text-teal-deep">Contact</p>
      <h1 class="mt-4 font-serif text-4xl md:text-5xl leading-[1.08] text-ink text-balance">Discuss a leadership challenge.</h1>
      <p class="mt-6 max-w-md leading-[1.7] text-steel">Tell me what is happening in your leadership team. Everything you write stays confidential, and there is no obligation to continue.</p>
      <p class="mt-6 text-sm text-steel">Prefer email? Write to <a class="border-b border-ink text-ink" href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
    <div class="mt-10 lg:mt-0 lg:col-span-7 max-w-xl"><ContactForm /></div>
  </section>
</Layout>
