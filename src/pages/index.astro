---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TestimonialGrid from '../components/TestimonialGrid.astro';
import EmailCapture from '../components/EmailCapture.astro';
import GuideCover from '../components/GuideCover.astro';
import { site } from '../data/site';
import { testimonials, coachingTestimonials, careerTestimonials } from '../data/testimonials';
import hero from '../assets/vincent/hero.jpg';
import coaching from '../assets/vincent/coaching.jpg';
import smile from '../assets/vincent/smile.jpg';

// Exact approved copy from "My USP.png". Do not paraphrase.
const story = [
  '26 years ago, following a communication course, I played a major part in bringing my mother and grandfather back together after 30 years of not speaking.',
  'Who I had become, and what I had learnt, helped change an entire family through conversations, one at a time.',
];
const turning = 'That experience taught me that the right conversation could change everything.';
const clients = 'Today, my clients come to me when the stakes are high and important conversations block progress.';
const upskill = [
  { w: 'Say', t: 'what needs to be said' },
  { w: 'Hear', t: 'what needs to be heard' },
  { w: 'Unstuck', t: 'what needs to be unstuck' },
];
---
<Layout
  path="/"
  type="ProfilePage"
  title="Vincent Azé | Expert in Difficult Conversations"
  description="Vincent Azé, expert in difficult conversations. Executive coach and Kuma Partners founding partner in Lisbon. I bridge the gap between silence and performance."
>
  <!-- 1. Hero -->
  <section class="relative overflow-hidden bg-charcoal text-bone" aria-labelledby="hero-h">
    <div class="container-x grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-12 lg:gap-14 lg:py-28">
      <div class="lg:col-span-7">
        <p class="label text-amber">Vincent Azé</p>
        <p class="mt-2 text-lg text-fog sm:text-xl">{site.descriptor}</p>
        <h1 id="hero-h" class="mt-8 text-[2.6rem] font-light leading-[1.04] tracking-[-0.03em] sm:text-6xl lg:text-[4.8rem]">I bridge the gap between <span class="text-amber">silence</span> and performance.</h1>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
          <a href={site.cta.href} class="btn-primary">{site.cta.label} <span aria-hidden="true">→</span></a>
          <a href="#testimonials" class="btn-secondary text-fog hover:text-amber">Read what clients say</a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-sm lg:ml-auto lg:mr-0 lg:max-w-none">
          <span class="pointer-events-none absolute inset-0 translate-x-3 translate-y-3 border border-amber/70" aria-hidden="true"></span>
          <Image src={hero} alt="Vincent Azé, executive coach and expert in difficult conversations" width={900} height={900} widths={[480, 720, 900]} sizes="(min-width: 1024px) 40vw, 90vw" loading="eager" fetchpriority="high" class="relative aspect-square w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. The personal story -->
  <section id="story" class="scroll-mt-20 bg-paper" aria-labelledby="story-h">
    <div class="container-x py-20 lg:py-32">
      <p class="label text-amber-deep">The story</p>
      <h2 id="story-h" class="sr-only">Where this started</h2>
      <div class="mt-8 max-w-[38rem] space-y-7 text-[1.3rem] font-light leading-[1.6] text-ink sm:text-2xl">
        {story.map((p) => <p class="reveal">{p}</p>)}
      </div>
      <blockquote class="reveal mt-14 max-w-4xl border-l-4 border-amber pl-6 text-[2rem] font-bold leading-[1.15] tracking-tight text-charcoal sm:text-4xl lg:mt-20 lg:pl-10 lg:text-[3.4rem]">
        {turning}
      </blockquote>
    </div>
  </section>

  <!-- 3. Why clients come -->
  <section id="work" class="scroll-mt-20 bg-charcoal text-bone" aria-labelledby="work-h">
    <div class="container-x grid gap-14 py-20 lg:grid-cols-12 lg:gap-16 lg:py-32">
      <div class="lg:col-span-7">
        <p class="label text-amber">Why clients come</p>
        <h2 id="work-h" class="reveal mt-6 max-w-xl text-2xl font-light leading-[1.4] sm:text-3xl">{clients}</h2>
        <p class="mt-12 text-fog">I up-skill them to</p>
        <ul class="mt-3">
          {upskill.map((u) => (
            <li class="reveal grid items-baseline gap-x-6 gap-y-1 border-t border-charcoal-line py-6 sm:py-7 lg:grid-cols-[17rem_1fr]">
              <span class="text-5xl font-bold uppercase tracking-tight text-amber sm:text-6xl">{u.w}</span>
              <span class="text-xl font-light sm:text-2xl">{u.t}</span>
            </li>
          ))}
        </ul>
        <p class="border-t border-charcoal-line pt-7 text-xl font-light sm:text-2xl">so they achieve greater results.</p>
        <p class="mt-10"><a href="/advisory" class="btn-outline border-amber/80 text-bone hover:bg-amber hover:text-charcoal">Explore executive coaching <span aria-hidden="true">→</span></a></p>
      </div>
      <div class="lg:col-span-5">
        <Image src={coaching} alt="Vincent Azé in conversation with two leaders, taking notes" width={720} height={900} widths={[400, 640, 720]} sizes="(min-width: 1024px) 38vw, 90vw" loading="lazy" class="mx-auto aspect-[4/5] w-full max-w-md object-cover lg:max-w-none" />
      </div>
    </div>
  </section>

  <!-- 4. Testimonials -->
  <section id="testimonials" class="scroll-mt-20 bg-cream" aria-labelledby="testimonials-h">
    <div class="container-x py-20 lg:py-32">
      <p class="label text-amber-deep">Testimonials</p>
      <h2 id="testimonials-h" class="mt-4 max-w-2xl text-4xl font-light leading-tight sm:text-5xl">In their words.</h2>
      <div class="mt-12 lg:mt-16">
        <TestimonialGrid featured={testimonials.marcin} coaching={coachingTestimonials.filter((t) => t.id !== 'marcin')} career={careerTestimonials} careerLabel="Recommendations from earlier in my career" />
      </div>
      <p class="mt-16 border-t border-line pt-8"><a href={site.cta.href} class="btn-primary">{site.cta.label} <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- 5. Lead magnet -->
  <section id="guide" class="scroll-mt-20 bg-paper" aria-labelledby="guide-h">
    <div class="container-x grid items-center gap-12 py-20 lg:grid-cols-12 lg:gap-16 lg:py-28">
      <div class="lg:col-span-4"><GuideCover /></div>
      <div class="lg:col-span-8 lg:pl-6">
        <p class="label text-amber-deep">Free guide</p>
        <h2 id="guide-h" class="mt-4 text-3xl font-light leading-tight sm:text-5xl">The Great Thing About Hard Conversations</h2>
        <p class="mt-4 max-w-xl text-lg text-steel">How the conversations we avoid can become the conversations that move us forward.</p>
        {site.features.guideReady ? (
          <a href={site.features.guideUrl} class="btn-primary mt-8" download>Get the free guide</a>
        ) : (
          <div class="mt-8 max-w-xl">
            <p class="mb-4 text-[0.95rem] text-steel">The guide is being finalised. Leave your email and I will send it as soon as it is ready.</p>
            <EmailCapture formName="guide-request" uid="g" button="Send me the guide when it’s ready" consentText="I agree that Vincent Azé uses my email address to send me this guide." alsoNewsletter />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 6. Newsletter (secondary) -->
  <section id="newsletter" class="scroll-mt-20 border-t border-line bg-cream" aria-labelledby="newsletter-h">
    <div class="container-x grid gap-8 py-12 lg:grid-cols-12 lg:gap-16 lg:py-16">
      <div class="lg:col-span-6">
        <p class="label text-amber-deep">Conversations That Matter</p>
        <h2 id="newsletter-h" class="mt-4 text-2xl font-light leading-tight sm:text-3xl">Better conversations. Better decisions. Better results.</h2>
        <p class="mt-4 max-w-md text-steel">Occasional insights on difficult conversations, leadership and the human side of business.</p>
      </div>
      <div class="lg:col-span-6 lg:pt-3"><EmailCapture formName="newsletter" uid="n" button="Subscribe" consentText="I agree to receive Vincent Azé’s newsletter by email. I can unsubscribe at any time." /></div>
    </div>
  </section>

  <!-- 7. Final CTA -->
  <section class="bg-charcoal text-bone" aria-labelledby="cta-h">
    <div class="container-x grid items-center gap-12 py-20 lg:grid-cols-12 lg:gap-16 lg:py-28">
      <div class="lg:col-span-8">
        <span class="block h-0.5 w-14 bg-amber" aria-hidden="true"></span>
        <h2 id="cta-h" class="mt-8 text-4xl font-light leading-[1.05] tracking-tight sm:text-6xl">Let’s have a conversation.</h2>
        <p class="mt-8"><a href={`mailto:${site.email}`} class="break-all border-b-2 border-amber pb-1 text-xl font-bold text-bone hover:text-amber sm:text-3xl">{site.email}</a></p>
        <p class="mt-10"><a href={site.cta.href} class="btn-primary">{site.cta.label} <span aria-hidden="true">→</span></a></p>
        <p class="mt-5 text-[0.95rem] text-fog">A short message is enough to begin.</p>
      </div>
      <div class="lg:col-span-4">
        <Image src={smile} alt="Vincent Azé smiling in a cap" width={480} height={600} widths={[320, 480]} sizes="(min-width: 1024px) 28vw, 70vw" loading="lazy" class="mx-auto aspect-[4/5] w-full max-w-xs rounded-sm object-cover lg:max-w-none" />
      </div>
    </div>
  </section>
</Layout>
