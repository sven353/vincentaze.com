---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/images/vincent-aze.jpg';
import { site } from '../data/site';

const situations = [
  {
    n: '01',
    title: 'A leadership team that no longer works as a team',
    lead: 'Talented people, sensible objectives, productive-looking meetings.',
    body: 'Yet unspoken tensions, unclear ownership and conflicting assumptions are slowing execution. Often the team needs a more honest conversation and a better way to work together more than another framework.',
  },
  {
    n: '02',
    title: 'The decision everyone can see, but nobody makes',
    lead: 'The same difficult choice keeps coming back.',
    body: 'A founder revisits it. An executive avoids challenging a colleague. We examine what is really blocking the decision, including the fears, loyalties and incentives beneath the surface.',
  },
  {
    n: '03',
    title: 'AI is accelerating the work, not the collaboration',
    lead: 'AI can improve analysis, content and execution.',
    body: 'It cannot automatically create trust, resolve resentment or help a team agree on who decides what. The competitive advantage increasingly lies in how people use their judgement, communicate and take responsibility together.',
  },
];

const perspectives = [
  {
    n: '01',
    title: 'Commercial reality',
    body: 'I understand targets, customers, execution pressure and what it costs when decisions are delayed.',
  },
  {
    n: '02',
    title: 'Human dynamics',
    body: 'My coaching work looks beyond the visible problem to what people are not saying, assuming or taking responsibility for.',
  },
  {
    n: '03',
    title: 'The AI transition',
    body: 'I explore how new technology changes work, and why emotional intelligence and human judgement become even more consequential.',
  },
];

const steps = [
  { n: '01', t: 'Bring the real situation', b: 'We start with the decision, relationship or transition that is actually demanding your attention.' },
  { n: '02', t: 'See what is underneath', b: 'We explore the assumptions, emotions, incentives and interactions maintaining the problem.' },
  { n: '03', t: 'Have the conversation that matters', b: 'We challenge the story, practise the difficult exchange and create space for real listening.' },
  { n: '04', t: 'Turn insight into action', b: 'We agree what changes, who owns it and how you will recognise progress.' },
];

const notes = [
  {
    title: 'The conversation that never happened',
    body: 'Two talented colleagues stop talking. Their teams notice. Meetings become performative and the organisation quietly adapts around the conflict. More sophisticated tools will not fix a relationship that people are avoiding. The first step is to create the conditions for a constructive conversation.',
  },
  {
    title: 'The founder who is still the decision bottleneck',
    body: "The company has grown, but important choices continue to return to one person. Delegation exists on paper and rarely in behaviour. The work is to explore trust, ownership and the founder's evolving identity as well as the organisational chart.",
  },
  {
    title: 'The AI programme without the human commitment',
    body: 'A company announces an ambitious adoption plan. Individual teams experiment enthusiastically, but managers have not agreed what should change in their roles, decisions or shared routines. The missing discussion is organisational and deeply human as well as technical.',
  },
];

const paths = [
  {
    primary: true,
    eyebrow: 'Individual',
    title: '1:1 Executive Coaching and Advisory',
    body: 'Confidential conversations for founders and senior executives navigating growth, change, conflict or important decisions. Personal, challenging and practical.',
    href: '/advisory',
    label: 'Explore 1:1 advisory',
    internal: true,
  },
  {
    eyebrow: 'Leadership teams · Kuma Partners',
    title: 'Leadership team work via Kuma Partners',
    body: 'When the issue is systemic rather than individual, I work with my partners on diagnostics, leadership alignment, founder relationships and strategic offsites, starting with the 14-Day Leadership Friction Scan.',
    href: site.links.kuma,
    label: 'Explore Kuma Partners',
  },
  {
    eyebrow: 'Speaking',
    title: 'Speaking, workshops and the future of work',
    body: 'Talks and facilitated conversations on the intersection of artificial intelligence, emotional intelligence and the changing nature of work. Designed to make audiences think and leave with practical questions.',
    href: '/ideas',
    label: 'Explore ideas and speaking',
    internal: true,
  },
];
---
<Layout
  path="/"
  title="Vincent Azé | Executive Coach, Leadership & the Future of Work"
  description={site.description}
>
  <section class="bg-linear-to-tr from-[#FAF8F4] via-[#F6F3EC] to-[#EBE6DB]">
    <div class="container-x pt-8 lg:pt-24 pb-12 lg:pb-24">
      <div class="flex flex-col lg:grid lg:grid-cols-12 lg:gap-x-16 lg:items-center">
        <div class="order-1 lg:order-none lg:col-span-7">
          <p class="mb-3 text-[10px] lg:text-[11px] font-medium tracking-[0.16em] uppercase text-steel">Executive coaching · Leadership advisory · The human side of AI</p>
          <h1 class="mb-5 font-serif text-3xl sm:text-4xl lg:text-6xl leading-tight lg:leading-[1.08] tracking-[-0.01em] text-ink text-balance max-w-[18ch]">Technology is moving faster. People still have to work together.</h1>
          <p class="mb-7 max-w-xl text-base lg:text-lg text-steel leading-relaxed">I work with founders, CEOs and senior leaders when growth, uncertainty and new technology expose the human problems that slow organisations down. Together, we turn difficult conversations into clearer decisions, stronger relationships and action that lasts.</p>
          <p class="mb-7 -mt-3 max-w-xl text-sm text-steel">Based in Lisbon. Working internationally through individual advisory and Kuma Partners.</p>
          <div class="hidden lg:block">
            <a href="/contact" class="inline-flex items-center gap-2 whitespace-nowrap rounded-sm bg-navy text-paper px-6 py-3.5 text-sm hover:bg-navy-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
            <a href="/about" class="ml-6 border-b border-ink pb-1 text-sm hover:text-teal-deep hover:border-teal-deep transition-colors">Get to know me</a>
            <span class="mt-3 block text-xs text-steel">Confidential. Direct. No obligation to continue.</span>
          </div>
        </div>
        <figure class="order-2 lg:order-none mb-6 lg:mb-0 lg:col-span-5">
          <div class="relative mx-auto w-full max-w-sm lg:max-w-none aspect-square overflow-hidden rounded-2xl lg:rounded-[1.75rem] border border-ink/5 bg-cream shadow-md">
            <Image
              src={portrait}
              alt="Vincent Azé, executive coach and founding partner of Kuma Partners"
              widths={[360, 560, 800]}
              sizes="(min-width: 1024px) 40vw, 90vw"
              format="webp"
              quality={82}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="absolute inset-0 size-full object-cover object-[50%_30%]"
            />
          </div>
          <figcaption class="mt-2 text-right text-[11px] tracking-wide text-steel/80">Vincent Azé · Founding Partner, Kuma Partners</figcaption>
        </figure>
        <div class="order-3 lg:hidden">
          <a href="/contact" class="flex w-full justify-center items-center gap-2 rounded-sm bg-navy text-paper px-6 py-3.5 text-sm hover:bg-navy-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
          <span class="mt-2 block text-center text-[11px] text-steel">Confidential. Direct. No obligation to continue.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-paper" aria-labelledby="situations-heading">
    <div class="container-x py-10 lg:py-24">
      <div class="reveal">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">The problems</p>
        <h2 id="situations-heading" class="mt-2 mb-8 font-serif text-3xl md:text-4xl text-ink max-w-xl text-balance">What brings leaders to the conversation.</h2>
      </div>
      <div class="border-t border-line mb-10" role="presentation"></div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 lg:gap-12">
        {situations.map((s, i) => (
          <article class:list={['reveal border-t border-line/80 pt-5 first:border-t-0 first:pt-0 lg:border-t-0 lg:pt-0', `delay-${(i + 1) * 100}`]}>
            <span class="mb-3 block text-xs text-teal-deep tabular-nums">{s.n}</span>
            <h3 class="mb-3 font-serif text-xl md:text-2xl text-ink leading-snug">{s.title}</h3>
            <p class="max-w-[40ch] text-[15px] sm:text-base leading-[1.7] text-steel"><strong class="font-semibold text-ink">{s.lead}</strong> {s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cream/70 border-y border-line/70" aria-labelledby="background-heading">
    <div class="container-x py-10 lg:py-24 lg:grid lg:grid-cols-12 lg:gap-16 lg:items-start">
      <div class="reveal lg:col-span-5 lg:sticky lg:top-28">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Who I am</p>
        <h2 id="background-heading" class="mt-2 font-serif text-3xl md:text-4xl text-ink text-balance">From international fintech to the human side of leadership.</h2>
        <p class="mt-6 text-[15px] sm:text-base leading-[1.7] text-steel">Before becoming an executive coach, I built my career in international financial technology and commercial leadership, working across cities including London and Hong Kong. I learned how organisations grow, how pressure shapes decisions and what happens when teams lose the ability to work through disagreement.</p>
        <p class="mt-4 text-[15px] sm:text-base leading-[1.7] text-steel">For around ten years, I have worked with leaders and teams on the conversations and changes that matter most. I am a founding partner of Kuma Partners, a leadership advisory firm working with founders and executive teams through strategic inflection points.</p>
        <a href="/about" class="mt-8 inline-flex items-center gap-2 text-sm border-b border-ink pb-1 hover:text-teal-deep hover:border-teal-deep transition-colors">Read my story <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-10 lg:mt-0 lg:col-span-7">
        <p class="reveal mb-4 text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Three perspectives I bring</p>
        <ol class="divide-y divide-line-strong/70 border-y border-line-strong/70">
          {perspectives.map((p, i) => (
            <li class:list={['reveal py-6 lg:py-8 sm:grid sm:grid-cols-[2.5rem_1fr] sm:gap-x-4', `delay-${(i + 1) * 100}`]}>
              <span class="mb-2 block sm:mb-0 sm:pt-1.5 text-xs text-teal-deep tabular-nums">{p.n}</span>
              <div>
                <h3 class="font-serif text-xl md:text-2xl text-ink leading-snug">{p.title}</h3>
                <p class="mt-3 max-w-[60ch] text-[15px] sm:text-base leading-[1.7] text-steel">{p.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-paper" aria-labelledby="process-heading">
    <div class="container-x py-10 lg:py-24">
      <div class="reveal">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">How we work</p>
        <h2 id="process-heading" class="mt-2 mb-10 md:mb-12 font-serif text-3xl md:text-4xl text-ink">What happens when we work together.</h2>
      </div>
      <ol class="relative grid grid-cols-1 gap-5 lg:gap-0 lg:grid-cols-4 lg:before:absolute lg:before:inset-x-0 lg:before:top-8 lg:before:border-t lg:before:border-line-strong lg:before:content-['']">
        {steps.map((s, i) => (
          <li class:list={['reveal relative lg:pr-8 border-t border-line/80 pt-5 first:border-t-0 first:pt-0 lg:border-t-0 lg:pt-0', i > 0 && `delay-${Math.min(i, 3) * 100}`]}>
            <span class="block h-5 text-xs leading-5 text-teal-deep tabular-nums">{s.n}</span>
            <span aria-hidden="true" class="hidden lg:block relative mt-3 h-0"><span class="absolute -top-[3.5px] left-0 size-[7px] rounded-full bg-navy"></span></span>
            <h3 class="mt-3 lg:mt-9 font-serif text-xl text-ink leading-snug">{s.t}</h3>
            <p class="mt-2 max-w-[34ch] text-[15px] sm:text-base leading-[1.7] text-steel">{s.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-navy text-paper" aria-labelledby="note-heading">
    <div class="container-x py-14 lg:py-24">
      <div class="reveal">
        <p class="text-[11px] tracking-[0.18em] text-fog uppercase font-medium">Practice notes</p>
        <h2 id="note-heading" class="mt-2 font-serif text-3xl md:text-4xl text-balance">Patterns I keep seeing.</h2>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-fog">These examples describe recurring leadership situations. They are not presented as verified client case studies or quantified outcomes.</p>
      </div>
      <div class="mt-10 grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
        {notes.map((n, i) => (
          <article class:list={['reveal border-t border-navy-line pt-5', `delay-${(i + 1) * 100}`]}>
            <h3 class="font-serif text-xl md:text-2xl leading-snug">{n.title}</h3>
            <p class="mt-3 max-w-[42ch] text-[15px] sm:text-base leading-[1.7] text-paper/90">{n.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-paper" aria-labelledby="paths-heading">
    <div class="container-x py-10 lg:py-24">
      <div class="reveal">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Ways to work</p>
        <h2 id="paths-heading" class="mt-2 mb-10 md:mb-12 font-serif text-3xl md:text-4xl text-ink">Three paths, one starting point.</h2>
      </div>
      <div class="rounded-2xl lg:rounded-[1.75rem] border border-ink/5 bg-cream/60 p-3 lg:p-4 grid grid-cols-1 lg:grid-cols-3 gap-3 lg:gap-4 items-stretch">
        {paths.map((c, i) => (
          <article class:list={['reveal flex flex-col rounded-2xl border p-6 lg:p-8', `delay-${(i + 1) * 100}`, c.primary ? 'border-line-strong bg-[#E9E4D8]' : 'border-line bg-white']}>
            <p class="mb-2 block text-[10px] tracking-[0.16em] text-steel uppercase font-medium">{c.eyebrow}</p>
            <h3 class="mb-3 font-serif text-2xl text-ink leading-snug">{c.title}</h3>
            <p class="mb-6 text-[15px] sm:text-base leading-[1.7] text-steel">{c.body}</p>
            <div class="mt-auto text-sm">
              {c.internal
                ? <a href={c.href} class="inline-flex items-center gap-2 rounded-sm bg-navy text-paper px-5 py-3 hover:bg-navy-hover transition-colors">{c.label} <span aria-hidden="true">→</span></a>
                : <a href={c.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 border-b border-ink pb-1 hover:text-teal-deep hover:border-teal-deep transition-colors">{c.label} <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cream/70 border-y border-line/70" aria-labelledby="event-heading">
    <div class="container-x py-12 lg:py-20 lg:grid lg:grid-cols-12 lg:gap-16 lg:items-center">
      <div class="reveal lg:col-span-4">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Upcoming · Portugal Tech Week</p>
        <p class="mt-2 font-serif text-5xl text-ink">11 Nov <span class="text-teal-deep">2026</span></p>
      </div>
      <div class="reveal delay-100 mt-6 lg:mt-0 lg:col-span-8">
        <h2 id="event-heading" class="font-serif text-2xl md:text-3xl text-ink text-balance">The Human Side of AI: Emotional Intelligence and the Future of Work</h2>
        <p class="mt-4 max-w-2xl text-[15px] sm:text-base leading-[1.7] text-steel">Vincent Azé speaks at Portugal Tech Week on why emotional intelligence and human judgement matter more as AI changes how organisations work. Read more in <a class="border-b border-ink hover:text-teal-deep hover:border-teal-deep" href="/ideas">ideas and speaking</a>.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="invite-heading">
    <div class="container-x py-16 lg:py-36 text-center reveal">
      <h2 id="invite-heading" class="display text-4xl md:text-7xl max-w-[16ch] mx-auto text-balance">What conversation have you been postponing?</h2>
      <a href="/contact" class="mt-12 inline-flex items-center gap-3 bg-navy text-paper px-8 py-4 text-sm hover:bg-navy-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
      <p class="mt-4 max-w-md mx-auto text-sm text-steel">You do not need to arrive with a polished problem statement. Tell me what is going on, what you have tried and what feels difficult to move.</p>
    </div>
  </section>
</Layout>
