---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/images/vincent-aze.jpg';
import { site } from '../data/site';

const situations = [
  {
    n: '01',
    title: 'Two leaders who have stopped talking',
    lead: 'Co-founders or executives who work around each other.',
    body: 'The relationship has become the bottleneck. The rest of the company adapts to it, and the cost shows up in speed long before anyone names it.',
  },
  {
    n: '02',
    title: 'Decisions that keep returning to the CEO',
    lead: 'Capable people, structural gridlock.',
    body: 'Responsibilities overlap, ownership is unclear and the same decision gets reopened. The CEO becomes the place where every unresolved question ends up.',
  },
  {
    n: '03',
    title: 'Agreement on Monday, drift by Thursday',
    lead: 'The meeting ends well. The execution does not follow.',
    body: 'Incentives and priorities were never truly aligned, so each function pursues its own version of the plan. The disagreement went underground instead of being resolved.',
  },
];

const pillars = [
  {
    n: '01',
    title: 'Revenue leadership',
    body: 'I am a former Chief Revenue Officer. I have carried commercial accountability, which is where leadership friction becomes visible first: in forecasts, in handovers between teams and in decisions that arrive late.',
  },
  {
    n: '02',
    title: 'Independent advisory practice',
    body: 'From March 2017 to February 2023 I worked worldwide as an executive advisor and leadership sparring partner, one conversation and one leadership team at a time.',
  },
  {
    n: '03',
    title: 'Kuma Partners',
    body: 'I am Managing Partner of Kuma Partners, a professional services firm that supports executives through high-stakes inflection points. I work with Dr. Sven Mulfinger and the Kuma partner team.',
  },
];

const steps = [
  { n: '01', t: 'Listen', b: 'Eight to ten confidential one-to-one interviews that let each person describe the friction in their own words.' },
  { n: '02', t: 'Measure', b: 'An asynchronous pulse check that shows where decisions slow down and how long they take to turn into action.' },
  { n: '03', t: 'Align', b: 'A two-hour debrief with the C-suite that puts the findings on the table and agrees what changes first.' },
  { n: '04', t: 'Embed', b: 'Where it helps, a 60 to 90 day Executive Alignment Sprint to redesign how the team decides and holds each other to it.' },
];

const paths = [
  {
    primary: true,
    eyebrow: 'Start here · Leadership teams',
    title: '14-Day Leadership Friction Diagnostic',
    body: 'The entry offer from Kuma Partners. A confidential diagnosis of where a leadership team loses time and trust, delivered with Dr. Sven Mulfinger and the partner team.',
    href: '/work',
    label: 'How the diagnostic works',
    internal: true,
  },
  {
    eyebrow: 'Leadership teams · Offsites',
    title: 'Leadership team offsites',
    body: 'Offsites for C-suite and leadership teams, prepared and facilitated around the decisions a team has been unable to make together.',
    href: site.links.offsite,
    label: 'kuma.partners/offsite',
  },
  {
    eyebrow: 'Founders and CEOs · Peer advisory',
    title: 'The Round',
    body: 'A confidential, year-round peer advisory for founders and CEOs, led by Dr. Sven Mulfinger in Barcelona. By application or nomination.',
    href: site.links.round,
    label: 'theround.kuma.partners',
  },
];
---
<Layout
  path="/"
  title="Vincent Azé | Managing Partner, Kuma Partners"
  description={site.description}
>
  <section class="bg-linear-to-tr from-[#FAF8F4] via-[#F6F3EC] to-[#EBE6DB]">
    <div class="container-x pt-8 lg:pt-24 pb-12 lg:pb-24">
      <div class="flex flex-col lg:grid lg:grid-cols-12 lg:gap-x-16 lg:items-center">
        <div class="order-1 lg:order-none lg:col-span-7">
          <p class="mb-3 text-[10px] lg:text-[11px] font-medium tracking-[0.16em] uppercase text-steel">Executive advisory · Scale-ups, Series A to C+</p>
          <h1 class="mb-5 font-serif text-3xl sm:text-4xl lg:text-6xl leading-tight lg:leading-[1.08] tracking-[-0.01em] text-ink text-balance max-w-[18ch]">When capable leaders stop moving together, the company slows down.</h1>
          <p class="mb-7 max-w-xl text-base lg:text-lg text-steel leading-relaxed">I am Vincent Azé, Managing Partner at Kuma Partners. I help founders and leadership teams resolve executive friction and shorten the time between a decision being needed and action starting.</p>
          <div class="hidden lg:block">
            <a href="/contact" class="inline-flex items-center gap-2 whitespace-nowrap rounded-sm bg-navy text-paper px-6 py-3.5 text-sm hover:bg-navy-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
            <a href="/work" class="ml-6 border-b border-ink pb-1 text-sm hover:text-teal-deep hover:border-teal-deep transition-colors">How I work</a>
            <span class="mt-3 block text-xs text-steel">Confidential. Direct. No obligation to continue.</span>
          </div>
        </div>
        <figure class="order-2 lg:order-none mb-6 lg:mb-0 lg:col-span-5">
          <div class="relative mx-auto w-full max-w-sm lg:max-w-none aspect-square overflow-hidden rounded-2xl lg:rounded-[1.75rem] border border-ink/5 bg-cream shadow-md">
            <Image
              src={portrait}
              alt="Vincent Azé, Managing Partner at Kuma Partners"
              widths={[360, 560, 800]}
              sizes="(min-width: 1024px) 40vw, 90vw"
              format="webp"
              quality={82}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="absolute inset-0 size-full object-cover object-[50%_30%]"
            />
          </div>
          <figcaption class="mt-2 text-right text-[11px] tracking-wide text-steel/80">Vincent Azé · Managing Partner, Kuma Partners</figcaption>
        </figure>
        <div class="order-3 lg:hidden">
          <a href="/contact" class="flex w-full justify-center items-center gap-2 rounded-sm bg-navy text-paper px-6 py-3.5 text-sm hover:bg-navy-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
          <span class="mt-2 block text-center text-[11px] text-steel">Confidential. Direct. No obligation to continue.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-paper" aria-labelledby="situations-heading">
    <div class="container-x py-10 lg:py-24">
      <div class="reveal">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Where the work starts</p>
        <h2 id="situations-heading" class="mt-2 mb-8 font-serif text-3xl md:text-4xl text-ink max-w-xl text-balance">Three situations I am asked to step into.</h2>
      </div>
      <div class="border-t border-line mb-10" role="presentation"></div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 lg:gap-12">
        {situations.map((s, i) => (
          <article class:list={['reveal border-t border-line/80 pt-5 first:border-t-0 first:pt-0 lg:border-t-0 lg:pt-0', `delay-${(i + 1) * 100}`]}>
            <span class="mb-3 block text-xs text-teal-deep tabular-nums">{s.n}</span>
            <h3 class="mb-3 font-serif text-xl md:text-2xl text-ink leading-snug">{s.title}</h3>
            <p class="max-w-[40ch] text-[15px] sm:text-base leading-[1.7] text-steel"><strong class="font-semibold text-ink">{s.lead}</strong> {s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cream/70 border-y border-line/70" aria-labelledby="background-heading">
    <div class="container-x py-10 lg:py-24 lg:grid lg:grid-cols-12 lg:gap-16 lg:items-start">
      <div class="reveal lg:col-span-5 lg:sticky lg:top-28">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Background</p>
        <h2 id="background-heading" class="mt-2 font-serif text-3xl md:text-4xl text-ink text-balance">I have carried the number and sat in the room.</h2>
        <p class="mt-6 font-serif text-xl sm:text-2xl leading-snug text-ink/85">My advice comes from commercial leadership and from years of working beside executive teams at the moments when a decision could go either way.</p>
        <a href="/about" class="mt-8 inline-flex items-center gap-2 text-sm border-b border-ink pb-1 hover:text-teal-deep hover:border-teal-deep transition-colors">More about my background <span aria-hidden="true">→</span></a>
      </div>
      <ol class="mt-10 lg:mt-0 lg:col-span-7 divide-y divide-line-strong/70 border-y border-line-strong/70">
        {pillars.map((p, i) => (
          <li class:list={['reveal py-6 lg:py-8 sm:grid sm:grid-cols-[2.5rem_1fr] sm:gap-x-4', `delay-${(i + 1) * 100}`]}>
            <span class="mb-2 block sm:mb-0 sm:pt-1.5 text-xs text-teal-deep tabular-nums">{p.n}</span>
            <div>
              <h3 class="font-serif text-xl md:text-2xl text-ink leading-snug">{p.title}</h3>
              <p class="mt-3 max-w-[60ch] text-[15px] sm:text-base leading-[1.7] text-steel">{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-paper" aria-labelledby="process-heading">
    <div class="container-x py-10 lg:py-24">
      <div class="reveal">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">The work</p>
        <h2 id="process-heading" class="mt-2 mb-10 md:mb-12 font-serif text-3xl md:text-4xl text-ink">How an engagement runs.</h2>
      </div>
      <ol class="relative grid grid-cols-1 gap-5 lg:gap-0 lg:grid-cols-4 lg:before:absolute lg:before:inset-x-0 lg:before:top-8 lg:before:border-t lg:before:border-line-strong lg:before:content-['']">
        {steps.map((s, i) => (
          <li class:list={['reveal relative lg:pr-8 border-t border-line/80 pt-5 first:border-t-0 first:pt-0 lg:border-t-0 lg:pt-0', i > 0 && `delay-${Math.min(i, 3) * 100}`]}>
            <span class="block h-5 text-xs leading-5 text-teal-deep tabular-nums">{s.n}</span>
            <span aria-hidden="true" class="hidden lg:block relative mt-3 h-0"><span class="absolute -top-[3.5px] left-0 size-[7px] rounded-full bg-navy"></span></span>
            <h3 class="mt-3 lg:mt-9 font-serif text-xl text-ink leading-snug">{s.t}</h3>
            <p class="mt-2 max-w-[34ch] text-[15px] sm:text-base leading-[1.7] text-steel">{s.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-navy text-paper" aria-labelledby="note-heading">
    <div class="container-x py-14 lg:py-24 lg:grid lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-4">
        <p class="text-[11px] tracking-[0.18em] text-fog uppercase font-medium">From Vincent's writing</p>
        <h2 id="note-heading" class="mt-2 font-serif text-3xl md:text-4xl text-balance">Faster tools do not remove the need to agree.</h2>
      </div>
      <div class="reveal delay-100 mt-8 lg:mt-0 lg:col-span-7 lg:col-start-6 space-y-5 text-base lg:text-lg leading-[1.7] text-paper/90 max-w-2xl">
        <p>Vincent recently wrote about two product managers in the same company who had not spoken to each other for two and a half years. They would not even attend the product meetings together.</p>
        <p>His point concerns the future of work. Give both of them AI tools to analyse information and draft proposals and they will work faster. At some point they still need to speak to each other and agree on a decision.</p>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm border-b border-paper pb-1 hover:text-fog hover:border-fog transition-colors">Follow Vincent on LinkedIn <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
      </div>
    </div>
  </section>

  <section class="bg-paper" aria-labelledby="paths-heading">
    <div class="container-x py-10 lg:py-24">
      <div class="reveal">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Through Kuma Partners</p>
        <h2 id="paths-heading" class="mt-2 mb-10 md:mb-12 font-serif text-3xl md:text-4xl text-ink">Three ways to work together.</h2>
      </div>
      <div class="rounded-2xl lg:rounded-[1.75rem] border border-ink/5 bg-cream/60 p-3 lg:p-4 grid grid-cols-1 lg:grid-cols-3 gap-3 lg:gap-4 items-stretch">
        {paths.map((c, i) => (
          <article class:list={['reveal flex flex-col rounded-2xl border p-6 lg:p-8', `delay-${(i + 1) * 100}`, c.primary ? 'border-line-strong bg-[#E9E4D8]' : 'border-line bg-white']}>
            <p class="mb-2 block text-[10px] tracking-[0.16em] text-steel uppercase font-medium">{c.eyebrow}</p>
            <h3 class="mb-3 font-serif text-2xl text-ink leading-snug">{c.title}</h3>
            <p class="mb-6 text-[15px] sm:text-base leading-[1.7] text-steel">{c.body}</p>
            <div class="mt-auto text-sm">
              {c.internal
                ? <a href={c.href} class="inline-flex items-center gap-2 rounded-sm bg-navy text-paper px-5 py-3 hover:bg-navy-hover transition-colors">{c.label} <span aria-hidden="true">→</span></a>
                : <a href={c.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 border-b border-ink pb-1 hover:text-teal-deep hover:border-teal-deep transition-colors">{c.label} <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cream/70 border-y border-line/70" aria-labelledby="event-heading">
    <div class="container-x py-12 lg:py-20 lg:grid lg:grid-cols-12 lg:gap-16 lg:items-center">
      <div class="reveal lg:col-span-4">
        <p class="text-[11px] tracking-[0.18em] text-steel uppercase font-medium">Upcoming · Lisbon</p>
        <p class="mt-2 font-serif text-5xl text-ink">11 Nov <span class="text-teal-deep">2026</span></p>
      </div>
      <div class="reveal delay-100 mt-6 lg:mt-0 lg:col-span-8">
        <h2 id="event-heading" class="font-serif text-2xl md:text-3xl text-ink text-balance">When rapid scale stalls: solving executive friction and decision latency in co-founder and leadership teams</h2>
        <p class="mt-4 max-w-2xl text-[15px] sm:text-base leading-[1.7] text-steel">A one-hour masterclass and discussion at PTW Palace during Portugal Tech Week, co-led by Vincent Azé and Dr. Sven Mulfinger for Kuma Partners.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="invite-heading">
    <div class="container-x py-16 lg:py-36 text-center reveal">
      <h2 id="invite-heading" class="display text-4xl md:text-7xl max-w-[16ch] mx-auto text-balance">Bring the decision your team keeps circling.</h2>
      <a href="/contact" class="mt-12 inline-flex items-center gap-3 bg-navy text-paper px-8 py-4 text-sm hover:bg-navy-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
      <p class="mt-4 text-sm text-steel">Confidential. Direct. No obligation to continue.</p>
    </div>
  </section>
</Layout>
