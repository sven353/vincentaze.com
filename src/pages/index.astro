---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TestimonialGrid from '../components/TestimonialGrid.astro';
import EmailCapture from '../components/EmailCapture.astro';
import GuideCover from '../components/GuideCover.astro';
import { site } from '../data/site';
import { testimonialList } from '../data/testimonials';
import hero from '../assets/vincent/hero.jpg';
import coaching from '../assets/vincent/coaching.jpg';
import smile from '../assets/vincent/smile.jpg';

// Exact approved copy from "My USP.png". Do not paraphrase.
const story = [
  '26 years ago, following a communication course, I played a major part in bringing my mother and grandfather back together after 30 years of not speaking.',
  'Who I had become, and what I had learnt, helped change an entire family through conversations, one at a time.',
];
const turning = 'That experience taught me that the right conversation could change everything.';
const clients = 'Today, my clients come to me when the stakes are high and important conversations block progress.';
const upskill = [
  { w: 'Say', t: 'what needs to be said' },
  { w: 'Hear', t: 'what needs to be heard' },
  { w: 'Unstuck', t: 'what needs to be unstuck' },
];
---
<Layout
  path="/"
  type="ProfilePage"
  title="Vincent Azé | Expert in Difficult Conversations"
  description="Vincent Azé, expert in difficult conversations. Executive coach and Kuma Partners founding partner in Lisbon. I bridge the gap between silence and performance."
>
  <!-- 1. Hero -->
  <section class="relative overflow-hidden bg-navy text-paper" aria-labelledby="hero-h">
    <div class="container-x grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-12 lg:gap-12 lg:py-24">
      <div class="lg:col-span-7">
        <p class="label text-gold">Vincent Azé</p>
        <p class="mt-2 text-lg text-fog sm:text-xl">{site.descriptor}</p>
        <h1 id="hero-h" class="mt-8 text-[2.6rem] font-light leading-[1.04] tracking-[-0.03em] sm:text-6xl lg:text-[4.6rem]">I bridge the gap between <span class="text-gold">silence</span> and performance.</h1>
        <span class="mt-8 block h-0.5 w-14 bg-gold" aria-hidden="true"></span>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="/contact" class="inline-flex items-center gap-2 rounded-sm bg-gold px-6 py-3.5 text-sm font-bold text-navy transition-colors hover:bg-[#f0bb5f]">Let’s have a conversation <span aria-hidden="true">→</span></a>
          <a href="#testimonials" class="inline-block py-2 text-sm text-fog border-b border-navy-line hover:text-gold hover:border-gold">Read what clients say</a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-sm lg:max-w-none lg:ml-auto lg:mr-0">
          <span class="pointer-events-none absolute inset-0 translate-x-3 translate-y-3 border border-gold/70" aria-hidden="true"></span>
          <Image src={hero} alt="Vincent Azé, executive coach and expert in difficult conversations" width={900} height={900} widths={[480, 720, 900]} sizes="(min-width: 1024px) 40vw, 90vw" loading="eager" fetchpriority="high" class="relative aspect-square w-full object-cover" />
        </div>
      </div>
    </div>
    <a href="#story" class="scroll-cue hidden items-center justify-center pb-6 text-fog hover:text-gold sm:flex" aria-label="Scroll to the story">
      <span class="flex flex-col items-center gap-2 text-xs uppercase tracking-[0.2em]">Scroll<span class="block h-8 w-px bg-gold"></span></span>
    </a>
  </section>

  <!-- 2. The personal story -->
  <section id="story" class="bg-paper scroll-mt-16" aria-labelledby="story-h">
    <div class="container-x py-16 lg:py-28">
      <p class="label text-gold-deep">The story</p>
      <h2 id="story-h" class="sr-only">Where this started</h2>
      <div class="mt-6 grid gap-8 lg:grid-cols-12">
        <div class="space-y-6 text-xl font-light leading-[1.55] text-ink sm:text-2xl lg:col-span-7">
          {story.map((p) => <p class="reveal">{p}</p>)}
        </div>
      </div>
      <blockquote class="reveal mt-12 max-w-4xl border-l-4 border-gold pl-6 text-3xl font-bold leading-[1.15] tracking-tight text-navy sm:text-4xl lg:mt-16 lg:pl-10 lg:text-[3.2rem]">
        {turning}
      </blockquote>
    </div>
  </section>

  <!-- 3. Why clients come -->
  <section id="work" class="bg-navy text-paper scroll-mt-16" aria-labelledby="work-h">
    <div class="container-x grid gap-12 py-16 lg:grid-cols-12 lg:gap-16 lg:py-28">
      <div class="lg:col-span-7">
        <p class="label text-gold">Why clients come</p>
        <h2 id="work-h" class="reveal mt-6 text-2xl font-light leading-[1.4] sm:text-3xl">{clients}</h2>
        <p class="mt-10 text-fog">I up-skill them to</p>
        <ul class="mt-2">
          {upskill.map((u) => (
            <li class="reveal grid items-baseline gap-x-6 gap-y-1 border-t border-navy-line py-5 lg:grid-cols-[16.5rem_1fr] sm:py-6">
              <span class="text-4xl font-bold uppercase tracking-tight text-gold sm:text-5xl">{u.w}</span>
              <span class="text-xl font-light sm:text-2xl">{u.t}</span>
            </li>
          ))}
        </ul>
        <p class="border-t border-navy-line pt-6 text-xl font-light sm:text-2xl">so they achieve greater results.</p>
      </div>
      <div class="lg:col-span-5">
        <Image src={coaching} alt="Vincent Azé in conversation with two leaders, taking notes" width={720} height={900} widths={[400, 640, 720]} sizes="(min-width: 1024px) 38vw, 90vw" loading="lazy" class="mx-auto aspect-[4/5] w-full max-w-md object-cover lg:max-w-none" />
      </div>
    </div>
  </section>

  <!-- 4. Testimonials -->
  <section id="testimonials" class="bg-cream scroll-mt-16" aria-labelledby="testimonials-h">
    <div class="container-x py-16 lg:py-28">
      <p class="label text-gold-deep">Testimonials</p>
      <h2 id="testimonials-h" class="mt-4 max-w-2xl text-3xl font-light leading-tight sm:text-5xl">In their words.</h2>
      <div class="mt-10 lg:mt-14"><TestimonialGrid items={testimonialList} /></div>
    </div>
  </section>

  <!-- 5. Lead magnet -->
  <section id="guide" class="bg-paper scroll-mt-16" aria-labelledby="guide-h">
    <div class="container-x grid items-center gap-12 py-16 lg:grid-cols-12 lg:gap-16 lg:py-28">
      <div class="lg:col-span-4"><GuideCover /></div>
      <div class="lg:col-span-8 lg:pl-6">
        <p class="label text-gold-deep">Free guide</p>
        <h2 id="guide-h" class="mt-4 text-3xl font-light leading-tight sm:text-5xl">The Great Thing About Hard Conversations</h2>
        <p class="mt-4 max-w-xl text-lg text-steel">How the conversations we avoid can become the conversations that move us forward.</p>
        {site.features.guideReady ? (
          <a href={site.features.guideUrl} class="mt-8 inline-flex rounded-sm bg-gold px-6 py-3.5 text-sm font-bold text-navy hover:bg-[#f0bb5f]" download>Get the free guide</a>
        ) : (
          <div class="mt-8 max-w-xl">
            <p class="mb-4 text-sm text-steel">The guide is being finalised. Leave your email and I will send it as soon as it is ready.</p>
            <EmailCapture formName="guide-request" uid="g" button="Get the free guide" consentText="I agree that Vincent Azé uses my email address to send me this guide." alsoNewsletter />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 6. Newsletter -->
  <section id="newsletter" class="bg-cream scroll-mt-16" aria-labelledby="newsletter-h">
    <div class="container-x grid gap-8 py-14 lg:grid-cols-12 lg:gap-16 lg:py-20">
      <div class="lg:col-span-6">
        <p class="label text-gold-deep">Conversations That Matter</p>
        <h2 id="newsletter-h" class="mt-4 text-3xl font-light leading-tight sm:text-4xl">Better conversations. Better decisions. Better results.</h2>
        <p class="mt-4 max-w-md text-steel">Occasional insights on difficult conversations, leadership and the human side of business.</p>
      </div>
      <div class="lg:col-span-6 lg:pt-3"><EmailCapture formName="newsletter" uid="n" button="Subscribe" consentText="I agree to receive Vincent Azé’s newsletter by email. I can unsubscribe at any time." /></div>
    </div>
  </section>

  <!-- 7. Final CTA -->
  <section class="bg-navy text-paper" aria-labelledby="cta-h">
    <div class="container-x grid items-center gap-10 py-16 lg:grid-cols-12 lg:gap-16 lg:py-24">
      <div class="lg:col-span-8">
        <span class="block h-0.5 w-14 bg-gold" aria-hidden="true"></span>
        <h2 id="cta-h" class="mt-8 text-4xl font-light leading-[1.05] tracking-tight sm:text-6xl">Let’s have a conversation.</h2>
        <p class="mt-8"><a href={`mailto:${site.email}`} class="break-all border-b-2 border-gold pb-1 text-xl font-bold text-paper hover:text-gold sm:text-3xl">{site.email}</a></p>
        <p class="mt-6 text-sm text-fog">Or <a class="border-b border-navy-line hover:text-gold hover:border-gold" href="/contact">send a short message</a>.</p>
      </div>
      <div class="lg:col-span-4">
        <Image src={smile} alt="Vincent Azé smiling in a cap" width={480} height={600} widths={[320, 480]} sizes="(min-width: 1024px) 28vw, 70vw" loading="lazy" class="mx-auto aspect-[4/5] w-full max-w-xs rounded-sm object-cover lg:max-w-none" />
      </div>
    </div>
  </section>
</Layout>

<style>
  .scroll-cue span > span { animation: cue 2.2s ease-in-out infinite; transform-origin: top; }
  @keyframes cue { 0%, 100% { transform: scaleY(0.4); opacity: 0.5; } 50% { transform: scaleY(1); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .scroll-cue span > span { animation: none; } }
</style>
