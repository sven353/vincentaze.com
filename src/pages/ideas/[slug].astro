---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';
import { site } from '../../data/site';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}
const { article } = Astro.props;
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout
  path={`/ideas/${article.slug}`}
  title={`${article.title} | Vincent Azé`}
  description={article.description}
  article={{ headline: article.title, datePublished: article.datePublished, dateModified: article.dateModified }}
>
  <article class="container-x py-12 lg:py-20">
    <p class="label text-teal-deep"><a href="/ideas" class="hover:underline">Ideas</a></p>
    <h1 class="mt-4 font-serif text-4xl md:text-6xl leading-[1.08] text-ink max-w-[22ch] text-balance">{article.title}</h1>
    <p class="mt-6 text-sm text-steel">
      By <a class="border-b border-ink text-ink" href="/about">Vincent Azé</a>, Executive Coach and Founding Partner, Kuma Partners ·
      <time datetime={article.datePublished}>{fmt(article.datePublished)}</time>
    </p>
    <div class="mt-10 max-w-2xl space-y-5 text-[17px] leading-[1.75] text-steel">
      <p class="font-serif text-2xl leading-snug text-ink">{article.intro}</p>
      {article.body.map((b) => b.h
        ? <h2 class="pt-6 font-serif text-2xl md:text-3xl text-ink">{b.h}</h2>
        : <p>{b.p}</p>)}
    </div>
    <aside class="mt-14 max-w-2xl border-t border-line-strong pt-6" aria-label="Related">
      <p class="label text-steel">Related</p>
      <ul class="mt-3 space-y-2">
        {article.related.map((r) => (
          <li>
            <a class="border-b border-ink text-ink hover:text-teal-deep hover:border-teal-deep" href={r.href} {...(r.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{r.label}{r.external && <span class="sr-only"> (opens in a new tab)</span>}</a>
          </li>
        ))}
      </ul>
      <a href="/contact" class="mt-8 inline-flex items-center gap-2 rounded-sm bg-navy px-6 py-3.5 text-sm text-paper hover:bg-navy-hover transition-colors">Discuss a leadership challenge <span aria-hidden="true">→</span></a>
    </aside>
  </article>
</Layout>
