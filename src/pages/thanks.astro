---
import Layout from '../layouts/Layout.astro';
---
<Layout path="/thanks" title="Thank you" description="Your enquiry has been received." noindex>
  <section class="container-x py-24 text-center">
    <h1 class="font-serif text-4xl md:text-5xl text-ink">Thank you.</h1>
    <p class="mt-4 text-steel">Your enquiry has arrived. Vincent will reply within 24 to 48 hours on working days.</p>
    <a href="/" class="mt-8 inline-block border-b border-ink pb-1 text-sm">Back to the home page</a>
  </section>
</Layout>
